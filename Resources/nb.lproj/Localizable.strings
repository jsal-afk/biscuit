"This image is no longer in the library." = "Dette bildet finnes ikke lenger i biblioteket.";
"This image is too large to edit safely." = "Dette bildet er for stort til å redigere på en sikker måte.";
"This library item is no longer available." = "Dette bibliotekelementet er ikke lenger tilgjengelig.";
"This long image exceeds the safe capture limit. Finish a shorter section or select a smaller area." = "Dette lange bildet overskrider den sikre opptaksgrensen. Fullfør en kortere del eller velg et mindre område.";
"This measurement could not be safely recorded. No measurement data was written." = "Denne målingen kunne ikke registreres på en sikker måte. Ingen måledata ble skrevet.";
"This removes the note from the in-app notebook. The original legacy Markdown file, if any, is not changed." = "Dette fjerner notatet fra notatboken i appen. Den opprinnelige eldre Markdown-filen, hvis den finnes, endres ikke.";
